  "@graph": [
    {
      "@id": "https://oceanenterprise.io/vocab/",
      "@type": "owl:Ontology",
      "dct:title": {
        "@value": "Ocean Enterprise Vocabulary",
        "@language": "en"
      },
      "dct:description": {
        "@value": "Terms used in the DCAT representation of Ocean Enterprise assets that are not covered by DCAT-AP or GeoDCAT-AP: blockchain, datatoken, compute-to-data, access-policy and pricing metadata.",
        "@language": "en"
      },
      "owl:versionInfo": "1.0.0",
      "dct:issued": {
        "@value": "2026-10-13",
        "@type": "xsd:date"
      },
      "dct:modified": {
        "@value": "2026-10-13",
        "@type": "xsd:date"
      },
      "dct:publisher": {
        "@id": "https://oceanenterprise.io"
      },
      "dct:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "vann:preferredNamespacePrefix": "oec",
      "vann:preferredNamespaceUri": "https://oceanenterprise.io/vocab/"
    },
    {
      "@id": "oec:Datatoken",
