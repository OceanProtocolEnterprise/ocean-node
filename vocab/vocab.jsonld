        "rdfs:Class",
        "owl:Class"
      ],
      "rdfs:label": {
        "@value": "Datatoken",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "ERC-20 access token granting access to one service of an asset.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://oceanenterprise.io/vocab/"
      }
    },
